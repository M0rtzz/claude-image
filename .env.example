# Copy to .env and fill in. .env is gitignored.
# Or just export these in your ~/.zshrc / ~/.bashrc — the script reads from the env.
# 复制为 .env 并填入。.env 已加入 .gitignore。
# 也可以直接 export 到 ~/.zshrc / ~/.bashrc 里——脚本从环境变量读取。

OPENAI_IMAGE_API_KEY=sk-replace-me
OPENAI_IMAGE_BASE_URL=https://jmrai.net/v1

# 充值 / Buy credits:  https://order.jmrai.net

# Optional: default is gpt-image-2.5-sunburst; use gpt-image-2.5-flare to switch.
# --model overrides this setting; legacy and host-specific model IDs also work.
# 可选：默认为 gpt-image-2.5-sunburst，也可切换为 gpt-image-2.5-flare。
# --model 优先于此设置；仍支持旧模型和网关自定义模型 ID。
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
